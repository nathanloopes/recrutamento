# Variáveis de ambiente — Recrutamento
# Copie para `.env` e preencha conforme o ambiente.

# Supabase (a anon key é pública por design)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Domínio público da aplicação (usado em links/notificações)
VITE_APP_URL=http://localhost:5173

# Cloudflare Turnstile (CAPTCHA anti-bot, opcional). Deixe vazio para desabilitar.
VITE_TURNSTILE_SITE_KEY=
